# Copy this file to .env and paste your values. .env is never committed to git.
# Real environment variables override values in .env.

# Local AI model (Ollama by default; no key needed for a local model)
AGENT_LLM_URL=http://127.0.0.1:11434/api/chat
AGENT_LLM_MODEL=llama3.2
AGENT_LLM_TIMEOUT=60

# Paste an API key here only if your model server requires one.
AGENT_LLM_API_KEY=

# WhatsApp Business API (planned; not used by the app yet)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
